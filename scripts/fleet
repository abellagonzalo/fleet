#!/usr/bin/env python3
"""fleet: run a fleet of interactive Claude Code workers as windows of one tmux session.
Usage: fleet <command> [args]   (run `fleet help`)"""
import os
import sys

FLEET = os.path.realpath(__file__)  # resolves the ~/.local/bin symlink
sys.path.insert(0, os.path.dirname(FLEET))

from fleetlib.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:], FLEET))
